{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/w/:id",
      "destination": "/wrapped"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/invite",
      "destination": "https://discord.com/oauth2/authorize?client_id=1556673636000211025&permissions=8581305633078976&integration_type=0&scope=bot+applications.commands",
      "permanent": false
    }
  ]
}